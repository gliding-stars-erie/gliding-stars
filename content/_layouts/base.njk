<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  {% set pageTitle = "Gliding Stars of Erie" if title == "Home" else title + " | Gliding Stars of Erie" %}
  {% set pageDescription = description if description else "Gliding Stars of Erie is an adaptive ice skating program in Erie, PA, helping individuals with disabilities build confidence, independence, and community through skating since 1999." %}
  {% set ogImage = og_image if og_image else "/assets/images/og-default.jpg" %}
  {% set absoluteUrl = siteUrl + (page.url | url) %}
  {% set absoluteImage = siteUrl + (ogImage | url) %}

  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="{{ absoluteUrl }}">

  <link rel="stylesheet" href="{{ '/css/style.css' | url }}?v={{ build }}">
  <link rel="icon" href="{{ '/assets/images/favicon.svg' | url }}" type="image/svg+xml">
  <link rel="alternate icon" href="{{ '/assets/images/favicon.svg' | url }}">
  <link rel="apple-touch-icon" href="{{ '/assets/images/favicon.svg' | url }}">

  <!-- Open Graph -->
  <meta property="og:site_name" content="Gliding Stars of Erie">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:image" content="{{ absoluteImage }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ absoluteUrl }}">

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDescription }}">
  <meta name="twitter:image" content="{{ absoluteImage }}">

  <!-- Organization structured data (shown on every page) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "NGO",
    "name": "Gliding Stars of Erie",
    "alternateName": "Gliding Stars",
    "url": "{{ siteUrl }}{{ '/gliding-stars/' | url }}",
    "logo": "{{ siteUrl }}{{ '/assets/images/logo.png' | url }}",
    "description": "Gliding Stars of Erie is an adaptive ice skating program helping individuals with disabilities grow physically, socially, and emotionally through the sport of ice-skating in Erie, PA.",
    "foundingDate": "1999",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Erie",
      "addressRegion": "PA",
      "postalCode": "16514",
      "addressCountry": "US"
    },
    "areaServed": {
      "@type": "City",
      "name": "Erie"
    }
  }
  </script>

  {% block head_extra %}{% endblock %}

</head>

<body class="{% if page.url == '/' %}home{% endif %}">

<header class="site-header">
  {% include "nav.njk" %}
</header>

<main>
  {% block content %}
    {{ content | safe }}
  {% endblock %}
</main>

{% include "footer.njk" %}

<script src="{{ '/js/main.js' | url }}?v={{ build }}" defer></script>

<!-- Netlify Identity — required for the /admin CMS login redirect -->
<script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
<script>
  if (window.netlifyIdentity) {
    window.netlifyIdentity.on("init", function(user) {
      if (!user) {
        window.netlifyIdentity.on("login", function() {
          document.location.href = "/admin/";
        });
      }
    });
  }
</script>

</body>
</html>