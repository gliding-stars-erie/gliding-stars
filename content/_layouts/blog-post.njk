{% extends "./base.njk" %}

{% block head_extra %}
  <meta property="og:type" content="article">
  <meta property="article:published_time" content="{{ page.date | isoDate }}">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": {{ title | dump | safe }},
    "datePublished": "{{ page.date | isoDate }}",
    "author": {
      "@type": "Person",
      "name": "Michael Simons"
    },
    "publisher": {
      "@type": "Organization",
      "name": "Gliding Stars of Erie",
      "logo": {
        "@type": "ImageObject",
        "url": "{{ siteUrl }}{{ '/assets/images/logo.png' | url }}"
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "{{ siteUrl }}{{ page.url | url }}"
    }
  }
  </script>
{% endblock %}

{% block content %}

<article class="blog-post section">

  <a href="{{ '/blogs/' | url }}" class="blog-post-back">&larr; All Posts</a>

  <header class="blog-post-header">
    <h1>{{ title }}</h1>
    <p class="blog-post-meta">{{ page.date | formatDate }}</p>
  </header>

  <div class="blog-post-body">
    {{ content | safe }}
  </div>

  {% set neighbors = collections.blogs | blogNeighbors(page.url) %}
  {% if neighbors.prev or neighbors.next %}
    <nav class="blog-post-nav">
      <div class="blog-post-nav-prev">
        {% if neighbors.prev %}
          <a href="{{ neighbors.prev.url | url }}" class="blog-nav-btn">
            <span class="blog-nav-arrow">&larr;</span>
            <span class="blog-nav-label">Previous</span>
            <span class="blog-nav-title">{{ neighbors.prev.data.title }}</span>
          </a>
        {% endif %}
      </div>
      <div class="blog-post-nav-next">
        {% if neighbors.next %}
          <a href="{{ neighbors.next.url | url }}" class="blog-nav-btn blog-nav-btn-right">
            <span class="blog-nav-label">Next</span>
            <span class="blog-nav-title">{{ neighbors.next.data.title }}</span>
            <span class="blog-nav-arrow">&rarr;</span>
          </a>
        {% endif %}
      </div>
    </nav>
  {% endif %}

</article>

{% endblock %}
